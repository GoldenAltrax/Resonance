# Backend Configuration
PORT=3000
JWT_SECRET=your-secret-key-change-in-production  # REQUIRED - generate a secure random string
DATABASE_URL=data/resonance.db
FRONTEND_URL=http://localhost:5173

# Production hostname served by Caddy over HTTPS (required for the PWA / service worker)
RESONANCE_HOST=your-vm.tailXXXX.ts.net

# Admin Configuration (optional - if not set, no admin access)
ADMIN_USERNAME=YourAdminUsername
ADMIN_EMAIL=admin@example.com

# Signup Configuration (optional - for legacy invite code support)
SIGNUP_SECRET=your-invite-code

# Frontend Configuration (optional): only set when the API is on a different origin.
# By default the frontend calls /api on its own origin (Vite proxy in dev, same server in prod).
# VITE_API_URL=https://music.example.com/api

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# AcoustID API key (free registration at https://acoustid.org/login)
# Required for cross-source duplicate detection via MusicBrainz
ACOUSTID_API_KEY=

# "Add music" downloader (all optional)
# DOWNLOAD_CONCURRENCY=2        # songs downloaded at the same time
# ITUNES_COUNTRY=US             # store used for search results and album info
# YTDLP_ARGS=                   # extra yt-dlp options if YouTube starts blocking, e.g. --cookies /app/backend/data/cookies.txt

# Assistant (admin chat panel). Off until ANTHROPIC_API_KEY is set.
# ANTHROPIC_API_KEY=             # console.anthropic.com -> API keys
# ASSISTANT_MODEL=claude-haiku-5-5
# TAVILY_API_KEY=                # optional, enables web search (tavily.com, 1,000 free searches/month)
