# Resonance reverse proxy.
#
# HTTPS is required: service workers (offline support, "Install app") only run in a
# secure context. Caddy obtains a certificate for *.ts.net names from the local tailscaled
# automatically; docker-compose.prod.yml mounts the tailscaled socket for that.
# Run `sudo tailscale cert <host>` once on the server if it hasn't been done before.
#
# Set RESONANCE_HOST in .env (e.g. your-vm.tailXXXX.ts.net), or replace it with a public
# domain to get a Let's Encrypt certificate instead.
#
# PUBLIC_HOST (e.g. resonancemusic.top) is served over plain HTTP to the cloudflared container:
# Cloudflare handles HTTPS for it at its edge, so Caddy needs no certificate for it.

{
    servers {
        # cloudflared connects from the Docker network; trust the visitor IP Cloudflare sends.
        # Anyone else (Tailscale devices) is identified by their own address.
        trusted_proxies static private_ranges
        client_ip_headers Cf-Connecting-Ip
    }
}

(resonance) {
    reverse_proxy resonance:3000 {
        # The real visitor, as worked out by client_ip_headers above (rate limits depend on it)
        header_up X-Forwarded-For {client_ip}
    }

    # Compress text responses only; audio is already compressed and must keep Range support
    encode {
        gzip
        zstd
        match {
            header Content-Type text/*
            header Content-Type application/json*
            header Content-Type application/javascript*
            header Content-Type image/svg+xml*
        }
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Large audio uploads
    request_body {
        max_size 100MB
    }

    log {
        output file /data/access.log {
            roll_size 10MB
            roll_keep 5
        }
        # Audio URLs carry the JWT as ?token= (media elements can't send headers): never log it
        format filter {
            fields {
                request>uri query {
                    replace token REDACTED
                }
                request>headers>Authorization delete
            }
            wrap json
        }
    }
}

{$RESONANCE_HOST:minecraft.tail93f9bc.ts.net} {
    import resonance
}

http://{$PUBLIC_HOST:public.invalid} {
    import resonance
}
